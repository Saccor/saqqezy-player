// The companion page as a Cloudflare static-assets Worker (no Worker script, only the files in dist/).
// Deploy with `pnpm companion:deploy` from the repo root: it builds with the production VITE_RELAY_URL and runs
// wrangler here (wrangler refuses to run at the pnpm workspace root). See docs/deploy-companion.md.
// dist/_headers (CSP, Referrer-Policy, nosniff) is generated by the build and applied by Workers static assets.
// The QR code opens `/#<fragment>`, so no single-page-application fallback is needed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saqqezy-companion",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist"
  },
  // No logs: the page is static and the Worker keeps nothing.
  "observability": {
    "enabled": false
  },
  "send_metrics": false
}
