# Cloudflare Pages response headers for the companion (copied into dist/ by Vite).
# DEPLOY: replace wss://RELAY_ORIGIN_PLACEHOLDER with the production relay origin (see docs/deploy-companion.md).
# img-src allows https: because channel logos come from the user's own playlist URLs.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' wss://RELAY_ORIGIN_PLACEHOLDER ws://127.0.0.1:8787; img-src 'self' data: https:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
