<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://example.test/IptvPlayer" version="0.1.0" viewmodes="maximized">
    <!--
      Fixed identity: package id "IptvPlyr01" (exactly 10 letters or digits), application id "<package id>.IptvPlayer".
      Signing (Apps2Samsung or Tizen Studio) uses your own certificate; the id itself does not have to be registered.
    -->
    <tizen:application id="IptvPlyr01.IptvPlayer" package="IptvPlyr01" required_version="6.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>Saqqezy Player</name>
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <!-- productinfo: Settings > Diagnostics reads the real model name (webapis.productinfo.getRealModel). -->
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <!-- unlimitedstorage: the movie and series lists (tens of thousands of titles) need more than the default quota. -->
    <tizen:privilege name="http://tizen.org/privilege/unlimitedstorage"/>
    <tizen:profile name="tv-samsung"/>
    <!--
      32:9 experiment (OFF). By default the app gets a 1920x1080 (16:9) viewport, letterboxed on ultrawide panels
      such as the Odyssey OLED G9. Samsung documents an opt-in for wider viewports. Enabling it also needs
      <meta name="viewport" content="width=device-width"> in index.html and a responsive layout, so leave it
      commented out until the Diagnostics numbers (Settings > Diagnostics) show what the monitor reports.
      <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"/>
    -->
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
