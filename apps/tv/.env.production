# Production builds (`vite build`, `pnpm build:tizen`). Values set in the shell win over these.
# Public addresses only: never put a key, token or password here (the build is shipped to TVs).

# The public trending feed (services/trending, docs/deploy-trending.md). The TV sends a bare GET; nothing about the user.
VITE_TRENDING_URL=https://iptv-trending-production.sacco-rezais.workers.dev/trending

# Beta only, while the trending Worker uses the free TMDB key: shows TMDB's attribution in Settings > About.
# Remove this line the day the TMDB_KEY secret is deleted.
VITE_TMDB_ATTRIBUTION=1
