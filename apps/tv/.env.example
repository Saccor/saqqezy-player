# Copy to apps/tv/.env.local (git-ignored) and fill in what you need. Every variable is optional.
# VITE_* values are compiled into the build that ships to TVs: never put anything secret here
# unless you accept that anyone with a build can read it.

# WebSocket URL of the companion relay (services/relay). Default: ws://127.0.0.1:8787 (pnpm relay:dev).
VITE_RELAY_URL=
# Origin of the companion phone page, encoded in the pairing QR code. Default: http://localhost:5174.
VITE_COMPANION_ORIGIN=
# Base URL of the public trending feed (services/trending). Without it, production builds show no trending rows.
VITE_TRENDING_URL=
# Set to 1 to show the TMDB attribution in Settings > About (builds whose trending feed uses a TMDB key).
VITE_TMDB_ATTRIBUTION=
# OpenSubtitles API key. Without it, "Find subtitles online" is not offered.
VITE_OPENSUBTITLES_API_KEY=
# Another server with the OpenSubtitles API (for example the fake provider). Default: the official API.
VITE_OPENSUBTITLES_URL=
