.superpowers/
node_modules/
dist/
coverage/
dist-tizen/
tools/fake-xtream/media/
# Local settings and keys (e.g. VITE_OPENSUBTITLES_API_KEY), never committed. See the .env.example files.
# apps/tv/.env.development and apps/tv/.env.production are tracked on purpose: builds need them, and they
# hold only a flag and public URLs.
*.local
# Wrangler local secrets and state (e.g. services/trending/.dev.vars with TMDB_KEY), never committed.
.dev.vars
.wrangler/
# Local tool state, editor settings and OS files.
.claude/
.vscode/
.DS_Store
Thumbs.db
# Build and run leftovers (TV packages are built locally, never committed).
*.wgt
*.ipk
*.log
*.tsbuildinfo
# Env files with real values (the tracked examples have none).
.env
.env.*.local
