{
  "name": "iptv-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/companion-protocol && tsc -p packages/storage && tsc -p tools/fake-xtream && tsc -p packages/app-api && tsc -p services/relay && tsc -p packages/platform && tsc -p packages/player && tsc -p apps/tv",
    "fake-xtream": "pnpm --filter @iptv/fake-xtream start",
    "dev": "node scripts/dev.mjs",
    "build:tv": "pnpm --filter @iptv/tv build",
    "build:tizen": "node tools/tizen/build-wgt.mjs",
    "relay:dev": "pnpm --filter @iptv/relay run dev",
    "relay:test:int": "node services/relay/scripts/integration.mjs",
    "relay:deploy": "pnpm --filter @iptv/relay run deploy"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "~2.1.8",
    "@types/node": "^22.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
