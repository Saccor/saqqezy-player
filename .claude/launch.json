{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tv-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "tv-dev-versions",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set FAKE_VOD_VERSIONS=1&& pnpm dev"
      ],
      "port": 5173
    },
    {
      "name": "tv-dev-failover",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set FAKE_VOD_VERSIONS=1&& set FAKE_DEAD_LIVE=4K&& pnpm dev"
      ],
      "port": 5173
    },
    {
      "name": "companion-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "companion:dev"
      ],
      "port": 5174
    }
  ]
}
