{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tv-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "tv-dev-versions",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set FAKE_VOD_VERSIONS=1&& pnpm dev"
      ],
      "port": 5173
    },
    {
      "name": "tv-dev-stress",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set CHANNELS=50000&& set CATCHUP=0&& pnpm dev"
      ],
      "port": 5173
    },
    {
      "name": "tv-dev-failover",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set FAKE_VOD_VERSIONS=1&& set FAKE_DEAD_LIVE=4K&& pnpm dev"
      ],
      "port": 5173
    },
    {
      "name": "companion-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "companion:dev"
      ],
      "port": 5174
    },
    {
      "name": "tv-rail",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "C:/Users/<user>/Desktop/Claude-Projects/iptv-app/.claude/worktrees/rail-close/apps/tv",
        "exec",
        "vite",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}